{
  "name": "@local/agora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agora v0.1: read-only asset census, health and advisory routing for DSH plugins, skills and MCPs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peishenglai3-hash/dsh-agora.git"
  },
  "homepage": "https://github.com/peishenglai3-hash/dsh-agora#readme",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/core.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "test/smoke.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/smoke.mjs",
    "check": "node --check index.js && node --check test/smoke.mjs"
  }
}

{
    "name":  "@peisheng_lai/dsh-agora",
    "version":  "1.1.1",
    "type":  "module",
    "description":  "Agora: read-only asset census, health and advisory routing for DSH plugins, skills and MCPs.",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/peishenglai3-hash/dsh-agora.git"
                   },
    "homepage":  "https://github.com/peishenglai3-hash/dsh-agora#readme",
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json"
                },
    "files":  [
                  "index.js",
                  "lib/core.mjs",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "README.md",
                  "LICENSE",
                  "CHANGELOG.md",
                  "docs",
                  "examples",
                  "skills",
                  "test/smoke.mjs"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "engines":  {
                    "node":  "\u003e=18"
                },
    "scripts":  {
                    "test":  "node --test test/smoke.mjs",
                    "check":  "node --check index.js \u0026\u0026 node --check test/smoke.mjs"
                },
    "publishConfig":  {
                          "access":  "public"
                      }
}